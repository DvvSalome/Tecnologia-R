# Copia a .env y rellena. Sin keys reales la app usa public/data/products.json.
# Guía: docs/SUPABASE-SETUP.md
# No subas .env al repositorio.

# Scripts (migrate / catalog:push) — service_role del Dashboard → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Frontend — anon / publishable (segura en el navegador)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key
